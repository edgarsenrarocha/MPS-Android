<?xml version="1.0" encoding="utf-8"?>
<!-- App theme and reusable widget styles. Restyle here rather than in individual layouts. -->
<resources>
    <style name="Theme.MpsDiag" parent="android:Theme.Material">
        <item name="android:colorPrimary">@color/bg_window</item>
        <item name="android:colorPrimaryDark">@color/bg_window</item>
        <item name="android:colorAccent">@color/brand_primary</item>
        <item name="android:colorControlActivated">@color/brand_primary</item>
        <item name="android:colorBackground">@color/bg_window</item>
        <item name="android:windowBackground">@color/bg_window</item>
        <item name="android:statusBarColor">@color/bg_window</item>
        <item name="android:navigationBarColor">@color/bg_window</item>
        <item name="android:textColorPrimary">@color/text_primary</item>
        <item name="android:textColorSecondary">@color/text_secondary</item>
        <item name="android:actionBarStyle">@style/ActionBar</item>
        <item name="android:buttonStyle">@style/Button.Secondary</item>
        <item name="android:alertDialogTheme">@style/Dialog</item>
    </style>

    <style name="ActionBar" parent="android:Widget.Material.ActionBar.Solid">
        <item name="android:background">@color/bg_window</item>
        <item name="android:elevation">0dp</item>
        <item name="android:titleTextStyle">@style/ActionBar.Title</item>
    </style>

    <style name="ActionBar.Title" parent="android:TextAppearance.Material.Widget.ActionBar.Title">
        <item name="android:textColor">@color/text_primary</item>
        <item name="android:fontFamily">sans-serif-medium</item>
    </style>

    <style name="Dialog" parent="android:Theme.Material.Dialog.Alert">
        <item name="android:colorAccent">@color/brand_primary</item>
        <item name="android:colorBackground">@color/bg_card_raised</item>
        <item name="android:textColorPrimary">@color/text_primary</item>
    </style>

    <!-- Containers -->
    <style name="Card">
        <item name="android:background">@drawable/bg_card</item>
        <item name="android:padding">@dimen/card_padding</item>
        <item name="android:layout_marginBottom">@dimen/gap</item>
    </style>

    <style name="MenuTile">
        <item name="android:background">@drawable/bg_tile</item>
        <item name="android:padding">@dimen/card_padding</item>
        <item name="android:clickable">true</item>
        <item name="android:focusable">true</item>
    </style>

    <style name="IconBadge">
        <item name="android:layout_width">@dimen/icon_badge</item>
        <item name="android:layout_height">@dimen/icon_badge</item>
        <item name="android:background">@drawable/bg_icon_badge</item>
        <item name="android:padding">10dp</item>
        <item name="android:tint">@color/brand_primary</item>
        <item name="android:scaleType">fitCenter</item>
    </style>

    <!-- Text -->
    <style name="Text.Display" parent="android:TextAppearance.Material">
        <item name="android:textColor">@color/text_primary</item>
        <item name="android:textSize">@dimen/text_display</item>
        <item name="android:fontFamily">sans-serif-medium</item>
    </style>

    <style name="Text.Title" parent="android:TextAppearance.Material.Title">
        <item name="android:textColor">@color/text_primary</item>
        <item name="android:textSize">@dimen/text_title</item>
        <item name="android:fontFamily">sans-serif-medium</item>
    </style>

    <style name="Text.Body" parent="android:TextAppearance.Material.Body1">
        <item name="android:textColor">@color/text_primary</item>
        <item name="android:textSize">@dimen/text_body</item>
    </style>

    <style name="Text.Secondary" parent="android:TextAppearance.Material.Body1">
        <item name="android:textColor">@color/text_secondary</item>
        <item name="android:textSize">@dimen/text_small</item>
    </style>

    <style name="Text.Value" parent="android:TextAppearance.Material">
        <item name="android:textColor">@color/text_primary</item>
        <item name="android:textSize">@dimen/text_value</item>
        <item name="android:fontFamily">sans-serif-medium</item>
    </style>

    <style name="Text.Caption" parent="android:TextAppearance.Material.Caption">
        <item name="android:textColor">@color/text_secondary</item>
        <item name="android:textSize">@dimen/text_caption</item>
    </style>

    <style name="Text.Chip" parent="android:TextAppearance.Material.Caption">
        <item name="android:textColor">@color/bg_window</item>
        <item name="android:textSize">@dimen/text_caption</item>
        <item name="android:fontFamily">sans-serif-medium</item>
    </style>

    <!-- Section heading on the home screen. -->
    <style name="SectionHeader" parent="android:TextAppearance.Material.Body2">
        <item name="android:textColor">@color/text_tertiary</item>
        <item name="android:textSize">@dimen/text_caption</item>
        <item name="android:fontFamily">sans-serif-medium</item>
        <item name="android:textAllCaps">true</item>
        <item name="android:letterSpacing">0.1</item>
        <item name="android:paddingTop">@dimen/gap</item>
        <item name="android:paddingBottom">@dimen/gap_small</item>
        <item name="android:paddingStart">4dp</item>
    </style>

    <!-- Buttons -->
    <style name="Button.Primary" parent="android:Widget.Material.Button">
        <item name="android:background">@drawable/bg_button_primary</item>
        <item name="android:textColor">@color/button_text_primary</item>
        <item name="android:fontFamily">sans-serif-medium</item>
        <item name="android:textAllCaps">false</item>
        <item name="android:textSize">@dimen/text_body</item>
        <item name="android:minHeight">52dp</item>
        <item name="android:paddingStart">20dp</item>
        <item name="android:paddingEnd">20dp</item>
        <item name="android:stateListAnimator">@null</item>
        <item name="android:layout_marginTop">4dp</item>
        <item name="android:layout_marginBottom">4dp</item>
    </style>

    <style name="Button.Secondary" parent="android:Widget.Material.Button">
        <item name="android:background">@drawable/bg_button_secondary</item>
        <item name="android:textColor">@color/button_text_secondary</item>
        <item name="android:fontFamily">sans-serif-medium</item>
        <item name="android:textAllCaps">false</item>
        <item name="android:textSize">@dimen/text_body</item>
        <item name="android:minHeight">52dp</item>
        <item name="android:paddingStart">20dp</item>
        <item name="android:paddingEnd">20dp</item>
        <item name="android:stateListAnimator">@null</item>
        <item name="android:layout_marginTop">4dp</item>
        <item name="android:layout_marginBottom">4dp</item>
    </style>
</resources>
